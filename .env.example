# FORGE の設定例。コピーして .env を作成し、値を入力する。

# Discord Bot のトークン（必須）
DISCORD_TOKEN=
# Discord アプリケーションの Client ID（必須）
DISCORD_CLIENT_ID=
# コマンド登録用（開発用ギルドの ID。register スクリプトで使用）
DISCORD_GUILD_ID=

# 全局停止スイッチ。1 / true / yes で全ギルドの Blueprint 実行を停止する
FORGE_DISABLED=0
# SQLite データベースのパス
FORGE_DB_PATH=data/forge.sqlite
